{$MERIFIELD_HOST} {
    tls {$ACME_EMAIL}
    encode zstd gzip
    request_body {
        max_size 10GB
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle_path /media/* {
        root * /srv/media
        file_server
    }
    handle {
        reverse_proxy app:8000
    }
}
